# Copy to .env and fill in. NEVER commit the real file (it is gitignored).
# On Koyeb these become service environment variables; on GitHub they are
# Actions secrets. The runtime image only reads the first block.

# ---- Koyeb service (addon) ------------------------------------------------
INSTALL_SECRET=          # REQUIRED. openssl rand -hex 32
MODE_DEFAULT=blockbuster
USER_LANGS=en
LOG_LEVEL=info

QDRANT_URL=              # https://xxxx.cloud.qdrant.io  (optional until M1 runs)
QDRANT_API_KEY=

# Personalisation. Without these the addon serves the bundled fixture catalog
# so you can verify the deployment; add them to go live.
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=      # EXPIRES after ~7 days on its own

# Auto-refresh. Trakt access tokens last 7 days and the refresh token is
# SINGLE-USE (each refresh returns a new one), so all three below are needed or
# the addon stops updating once the access token dies. The rotated pair is
# persisted to Qdrant, which means these two only need to be correct at the
# FIRST boot; after that the stored tokens win.
TRAKT_REFRESH_TOKEN=     # from trakt_login.py (printed next to the access token)
TRAKT_CLIENT_SECRET=     # your Trakt app's secret
TRAKT_REDIRECT_URI=      # must match the app registration byte-for-byte,
                         # e.g. https://<service>.koyeb.app/ingest/trakt/callback

# ---- GitHub Actions only (ingest job) -------------------------------------
TMDB_TOKEN=              # v4 bearer token (v3 keys need the ?api_key= form)

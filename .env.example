# Copy to .env and fill in. NEVER commit the real file (it is gitignored).
# On Koyeb these become service environment variables; on GitHub they are
# Actions secrets. The runtime image only reads the first block.

# ---- Koyeb service (addon) ------------------------------------------------
INSTALL_SECRET=          # REQUIRED. openssl rand -hex 32
MODE_DEFAULT=blockbuster
USER_LANGS=en
LOG_LEVEL=info

QDRANT_URL=              # https://xxxx.cloud.qdrant.io  (optional until M1 runs)
QDRANT_API_KEY=

# Personalisation. Without these the addon serves the bundled fixture catalog
# so you can verify the deployment; add them to go live.
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=

# ---- GitHub Actions only (ingest job) -------------------------------------
TMDB_TOKEN=              # v4 bearer token (v3 keys need the ?api_key= form)
